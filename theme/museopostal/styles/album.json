{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Álbum",
	"settings": {
		"color": {
			"palette": [
				{
					"slug": "base",
					"color": "#F4EAD5",
					"name": "Papel"
				},
				{
					"slug": "surface",
					"color": "#FBF6EC",
					"name": "Papel claro"
				},
				{
					"slug": "contrast",
					"color": "#2B2320",
					"name": "Texto"
				},
				{
					"slug": "primary",
					"color": "#1A2E44",
					"name": "Tinta"
				},
				{
					"slug": "secondary",
					"color": "#6B5F55",
					"name": "Texto secundario"
				},
				{
					"slug": "accent",
					"color": "#8A1538",
					"name": "Granate"
				},
				{
					"slug": "mount",
					"color": "#1B1B1B",
					"name": "Montura negra"
				}
			]
		},
		"custom": {
			"filete": "#B08D2E",
			"logo": "propuesta-a",
			"textoMontura": "var(--wp--preset--color--base)"
		},
		"spacing": {
			"spacingSizes": [
				{
					"slug": "10",
					"size": "0.5rem",
					"name": "1"
				},
				{
					"slug": "20",
					"size": "0.75rem",
					"name": "2"
				},
				{
					"slug": "30",
					"size": "1.25rem",
					"name": "3"
				},
				{
					"slug": "40",
					"size": "clamp(1.5rem, 3vw, 2.25rem)",
					"name": "4"
				},
				{
					"slug": "50",
					"size": "clamp(2.25rem, 5vw, 3.5rem)",
					"name": "5"
				},
				{
					"slug": "60",
					"size": "clamp(3rem, 8vw, 5.5rem)",
					"name": "6"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Titulares (Newsreader)",
					"fontFamily": "Newsreader, Georgia, 'Times New Roman', Times, serif",
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/album/newsreader-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Newsreader",
							"fontStyle": "italic",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/album/newsreader-italic-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "body",
					"name": "Cuerpo (Newsreader)",
					"fontFamily": "Newsreader, Georgia, 'Times New Roman', Times, serif"
				},
				{
					"slug": "ui",
					"name": "Interfaz (Public Sans)",
					"fontFamily": "\"Public Sans\", system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Public Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/album/public-sans-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Public Sans",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/album/public-sans-italic-latin.woff2"
							],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "1rem",
					"name": "Pequeño",
					"fluid": false
				},
				{
					"slug": "medium",
					"size": "1.25rem",
					"name": "Normal",
					"fluid": {
						"min": "1.1875rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "large",
					"size": "1.625rem",
					"name": "Grande",
					"fluid": {
						"min": "1.375rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "x-large",
					"size": "2.25rem",
					"name": "Muy grande",
					"fluid": {
						"min": "1.75rem",
						"max": "2.5rem"
					}
				},
				{
					"slug": "xx-large",
					"size": "3rem",
					"name": "Enorme",
					"fluid": {
						"min": "2.25rem",
						"max": "3.5rem"
					}
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"css": "a{text-decoration-thickness:1px;text-underline-offset:0.18em}\na:hover{text-decoration-thickness:2px}\nh1,h2,h3,h4,.wp-block-site-title{font-optical-sizing:auto;text-wrap:balance}\n.mp-cabecera{border-bottom:1px solid var(--wp--custom--filete)}\n.wp-block-navigation:not(.has-background) .wp-block-navigation__submenu-container{background-color:var(--wp--preset--color--surface);color:var(--wp--preset--color--contrast);border:1px solid var(--wp--custom--filete)}\n.wp-block-navigation:not(.has-background) .wp-block-navigation__responsive-container.is-menu-open{background-color:var(--wp--preset--color--base);color:var(--wp--preset--color--contrast)}\n.is-style-montura,.mp-montura{padding:clamp(1rem,4vw,3rem)}\n.is-style-montura figcaption,.mp-montura figcaption,.is-style-montura figcaption a,.mp-montura figcaption a{color:var(--wp--custom--texto-montura)}\n.mp-montura :focus-visible,.is-style-montura :focus-visible{outline-color:var(--wp--custom--texto-montura)}\n.mp-imagenes__lista{grid-template-columns:repeat(auto-fit,minmax(min(100%,15rem),1fr));align-items:start}\n.is-style-tarjeta{border:1px solid color-mix(in srgb,var(--wp--preset--color--contrast) 14%,transparent)}\n.mp-puertas__central{outline:0;border-top:4px solid var(--wp--preset--color--accent)}\n.mp-datos,.mp-cita,.mp-licencia{font-family:var(--wp--preset--font-family--ui)}\n.mp-datos dd{font-size:var(--wp--preset--font-size--small)}\n.wp-block-quote{border-left:2px solid var(--wp--preset--color--accent);padding-left:1.25rem}\n.mp-pie .wp-block-separator.is-style-perforado{background:radial-gradient(circle at 6px 6px,var(--wp--preset--color--surface) 3.5px,transparent 4px) 0 0/12px 12px repeat-x,var(--wp--custom--filete)}",
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "500",
					"lineHeight": "1.15"
				}
			},
			"h3": {
				"typography": {
					"fontWeight": "600"
				}
			},
			"h4": {
				"typography": {
					"fontWeight": "600"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)",
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--secondary)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)",
					"fontWeight": "600"
				}
			},
			"core/post-title": {
				"typography": {
					"fontWeight": "500"
				}
			},
			"core/quote": {
				"typography": {
					"fontStyle": "italic"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--custom--filete)"
				}
			}
		}
	}
}
