{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Sala blanca",
	"settings": {
		"color": {
			"palette": [
				{ "slug": "base", "color": "#FFFFFF", "name": "Fondo" },
				{ "slug": "surface", "color": "#F7F6F3", "name": "Fondo alterno" },
				{ "slug": "contrast", "color": "#1F1F1F", "name": "Texto" },
				{ "slug": "primary", "color": "#1F1F1F", "name": "Titulares" },
				{ "slug": "secondary", "color": "#5E5E5E", "name": "Texto secundario" },
				{ "slug": "accent", "color": "#8A1538", "name": "Granate" },
				{ "slug": "mount", "color": "#EDEBE6", "name": "Paspartú" }
			]
		},
		"custom": {
			"filete": "var(--wp--preset--color--mount)"
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "10", "size": "0.5rem", "name": "1" },
				{ "slug": "20", "size": "1rem", "name": "2" },
				{ "slug": "30", "size": "1.5rem", "name": "3" },
				{ "slug": "40", "size": "clamp(1.75rem, 3.5vw, 2.5rem)", "name": "4" },
				{ "slug": "50", "size": "clamp(2.5rem, 6vw, 4rem)", "name": "5" },
				{ "slug": "60", "size": "clamp(3.5rem, 9vw, 6.5rem)", "name": "6" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Titulares (Instrument Serif)",
					"fontFamily": "'Instrument Serif', Georgia, 'Times New Roman', serif",
					"fontFace": [
						{
							"fontFamily": "Instrument Serif",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/sala-blanca/instrument-serif-latin-regular.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Instrument Serif",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/sala-blanca/instrument-serif-latin-italic.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "body",
					"name": "Cuerpo (Atkinson Hyperlegible Next)",
					"fontFamily": "'Atkinson Hyperlegible Next', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Atkinson Hyperlegible Next",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/sala-blanca/atkinson-hyperlegible-next-latin-var.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						},
						{
							"fontFamily": "Atkinson Hyperlegible Next",
							"fontStyle": "italic",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/sala-blanca/atkinson-hyperlegible-next-latin-var-italic.woff2" ],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				},
				{
					"slug": "ui",
					"name": "Interfaz (Atkinson Hyperlegible Next)",
					"fontFamily": "'Atkinson Hyperlegible Next', system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "1rem", "name": "Pequeño", "fluid": false },
				{ "slug": "medium", "size": "1.1875rem", "name": "Normal", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "large", "size": "1.5rem", "name": "Grande", "fluid": { "min": "1.375rem", "max": "1.75rem" } },
				{ "slug": "x-large", "size": "2.5rem", "name": "Muy grande", "fluid": { "min": "2.125rem", "max": "3.25rem" } },
				{ "slug": "xx-large", "size": "3.5rem", "name": "Enorme", "fluid": { "min": "2.625rem", "max": "4.5rem" } }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.5rem"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--accent)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--contrast)" }
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontWeight": "700",
					"lineHeight": "1.3"
				}
			},
			"h1": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"fontWeight": "400",
					"lineHeight": "1.05"
				}
			},
			"h2": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"fontWeight": "400",
					"lineHeight": "1.1"
				}
			},
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "400",
					"lineHeight": "1.1"
				},
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--primary)" },
						"typography": { "textDecoration": "none" },
						":hover": {
							"color": { "text": "var(--wp--preset--color--accent)" }
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--contrast)" },
						"typography": { "textDecoration": "none" },
						":hover": {
							"color": { "text": "var(--wp--preset--color--accent)" }
						}
					}
				}
			},
			"core/heading": {
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--primary)" },
						":hover": {
							"color": { "text": "var(--wp--preset--color--accent)" }
						}
					}
				}
			},
			"core/post-title": {
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--primary)" },
						"typography": { "textDecoration": "none" },
						":hover": {
							"color": { "text": "var(--wp--preset--color--accent)" }
						}
					}
				}
			},
			"core/quote": {
				"typography": { "fontStyle": "italic" }
			}
		},
		"css": "body a:not(.wp-element-button){text-underline-offset:0.2em;text-decoration-thickness:1px}body a:not(.wp-element-button):hover{text-decoration-thickness:2px}:is(h1,h2,.wp-block-site-title,.mp-cifras strong){font-synthesis:none}.mp-cifras strong{font-weight:400}.wp-block-group.mp-cabecera{padding-block:var(--wp--preset--spacing--40)}.wp-block-group.mp-pie{background:var(--wp--preset--color--surface)}:is(.wp-block-image,.wp-block-post-featured-image).is-style-montura{padding:clamp(1.25rem,5vw,4rem)}.mp-tarjeta-pieza .wp-block-post-featured-image.is-style-montura{padding:clamp(0.75rem,2vw,1.25rem)}.wp-block-group.is-style-tarjeta{background:var(--wp--preset--color--base);border-top:1px solid var(--wp--preset--color--contrast);padding:var(--wp--preset--spacing--20) 0 0}.wp-block-group.is-style-tarjeta.mp-puertas__central{outline:0;border-top:4px solid var(--wp--preset--color--accent)}"
	}
}
