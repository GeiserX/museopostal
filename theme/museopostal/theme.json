{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": true,
		"border": {
			"color": false,
			"radius": false,
			"style": false,
			"width": false
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"link": false,
			"palette": [
				{ "slug": "base", "color": "#FFFFFF", "name": "Fondo" },
				{ "slug": "surface", "color": "#F5F4F1", "name": "Superficie" },
				{ "slug": "contrast", "color": "#1F1F1F", "name": "Texto" },
				{ "slug": "primary", "color": "#1F3A5A", "name": "Titulares y enlaces" },
				{ "slug": "secondary", "color": "#5A5A5A", "name": "Texto secundario" },
				{ "slug": "accent", "color": "#8A1538", "name": "Acento" },
				{ "slug": "mount", "color": "#E8E6E1", "name": "Montura" }
			]
		},
		"custom": {
			"filete": "var(--wp--preset--color--accent)",
			"logo": "propuesta-a",
			"textoMontura": "var(--wp--preset--color--contrast)"
		},
		"dimensions": {
			"aspectRatio": false,
			"minHeight": false
		},
		"layout": {
			"contentSize": "40rem",
			"wideSize": "71.25rem",
			"allowEditing": false,
			"allowCustomContentAndWideSize": false
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [ "rem", "%" ],
			"spacingSizes": [
				{ "slug": "10", "size": "0.5rem", "name": "1" },
				{ "slug": "20", "size": "0.75rem", "name": "2" },
				{ "slug": "30", "size": "1.25rem", "name": "3" },
				{ "slug": "40", "size": "clamp(1.5rem, 3vw, 2rem)", "name": "4" },
				{ "slug": "50", "size": "clamp(2rem, 5vw, 3rem)", "name": "5" },
				{ "slug": "60", "size": "clamp(3rem, 7vw, 4.5rem)", "name": "6" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": false,
			"lineHeight": false,
			"textDecoration": false,
			"textTransform": false,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Titulares",
					"fontFamily": "Georgia, 'Times New Roman', Times, serif"
				},
				{
					"slug": "body",
					"name": "Cuerpo",
					"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
				},
				{
					"slug": "ui",
					"name": "Interfaz",
					"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "1rem", "name": "Pequeño", "fluid": false },
				{ "slug": "medium", "size": "1.1875rem", "name": "Normal", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "large", "size": "1.5rem", "name": "Grande", "fluid": { "min": "1.3125rem", "max": "1.625rem" } },
				{ "slug": "x-large", "size": "2rem", "name": "Muy grande", "fluid": { "min": "1.625rem", "max": "2.25rem" } },
				{ "slug": "xx-large", "size": "2.75rem", "name": "Enorme", "fluid": { "min": "2.125rem", "max": "3.25rem" } }
			]
		},
		"blocks": {
			"core/button": {
				"border": { "radius": false }
			},
			"core/image": {
				"lightbox": { "allowEditing": true, "enabled": true }
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var(--wp--preset--spacing--30)",
				"right": "var(--wp--preset--spacing--30)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": { "textDecoration": "underline" },
				":hover": {
					"color": { "text": "var(--wp--preset--color--accent)" }
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"spacing": {
					"padding": {
						"top": "0.7rem",
						"bottom": "0.7rem",
						"left": "1.2rem",
						"right": "1.2rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				}
			},
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "600",
					"lineHeight": "1.2"
				},
				"elements": {
					"link": {
						"color": { "text": "var(--wp--preset--color--primary)" },
						"typography": { "textDecoration": "none" }
					}
				}
			},
			"core/site-tagline": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/search": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--ui)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/post-excerpt": {
				"color": { "text": "var(--wp--preset--color--secondary)" }
			},
			"core/quote": {
				"typography": { "fontStyle": "italic" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Cabecera", "area": "header" },
		{ "name": "footer", "title": "Pie", "area": "footer" }
	],
	"customTemplates": []
}
