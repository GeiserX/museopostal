{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Museo Postal: muestra",
		"description": "Tema museopostal y plugin museopostal-coleccion con 8 piezas reales, 2 artículos y 6 páginas de museopostal.org. Espera que el tema y el plugin ya estén en wp-content (el CLI los monta; la vista previa de PR los instala desde la rama).",
		"author": "GeiserX",
		"categories": [
			"Theme"
		]
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.4",
		"wp": "7.1"
	},
	"features": {
		"networking": true
	},
	"login": true,
	"steps": [
		{
			"step": "setSiteLanguage",
			"language": "es_ES"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "Museo Postal y Filatélico de la Región de Murcia",
				"blogdescription": "Filatelia e historia postal desde la Región de Murcia",
				"permalink_structure": "/articulos/%postname%/",
				"timezone_string": "Europe/Madrid",
				"date_format": "j \\d\\e F \\d\\e Y",
				"default_comment_status": "closed",
				"default_ping_status": "closed"
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "museopostal-coleccion/museopostal-coleccion.php"
		},
		{
			"step": "activateTheme",
			"themeFolderName": "museopostal"
		},
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/uploads/muestra"
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/uploads/muestra/1866_81-85_ANV.jpg",
			"data": {
				"resource": "bundled",
				"path": "/muestra/1866_81-85_ANV.jpg"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/uploads/muestra/1918_tarjeta-campana_ANV.jpg",
			"data": {
				"resource": "bundled",
				"path": "/muestra/1918_tarjeta-campana_ANV.jpg"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/uploads/muestra/1918_tarjeta-campana_REV.jpg",
			"data": {
				"resource": "bundled",
				"path": "/muestra/1918_tarjeta-campana_REV.jpg"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/uploads/muestra/1938_775_sellos.jpg",
			"data": {
