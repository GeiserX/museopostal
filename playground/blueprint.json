			"file": {
				"resource": "bundled",
				"path": "/muestra.xml"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/museopostal-muestra.php",
			"data": {
				"resource": "bundled",
				"path": "/muestra.php"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php\nrequire \"/wordpress/wp-load.php\";\nrequire \"/wordpress/wp-content/museopostal-muestra.php\";\nunlink( \"/wordpress/wp-content/museopostal-muestra.php\" );"
		}
